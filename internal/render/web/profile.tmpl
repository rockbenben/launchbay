{{define "profile"}}<!doctype html>
<html lang="{{.Lang}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{with .Background}} data-bg="1" style="background-image:linear-gradient(var(--scrim),var(--scrim)),url({{.}})"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Launchbay">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#121417">
<link rel="manifest" href="/manifest.webmanifest">
<title>{{.PageTitle}} · {{.Profile.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body data-profile-layout="{{.Profile.Layout}}"{{with .Profile.View}} data-profile-view="{{.}}"{{end}} data-profile="{{.Profile.ID}}" data-rev="{{.Rev}}"{{with .Add}} data-add="{{.}}" data-add-title="{{$.AddTitle}}"{{end}}>
<header>
  {{/* 顶栏这行大字是**这一页叫什么**（Profile.PageTitle，可在「改名」那一格里改），
       空则按界面语言给通用默认。它和"这是谁的那一份"是两件事，浏览器标签页把两件
       都写上（`页面名 · 档案名`）——切换标签页时认的是后者，看内容时读的是前者。

       这一格从前是档案名（2026-10-10 的改判），因为那时唯一的候选是
       Bookmarks.Title，而它是一个所有人共用的常量「发射台」：三个人的台子顶栏
       同名，进门之后认不出自己在谁的台上。今天档案名挪到了右上角那颗常驻的
       徽标上（见下面 profmenu 那段），"认人"这一维没有丢，只是不再占用标题那一格。 */}}
  <h1 title="{{.PageTitle}}">{{.PageTitle}}</h1>
  <form class="search" method="get" action="/" role="search">
    <input type="search" name="q" value="{{.Query}}" aria-label="{{.T "profile.search.aria"}}" placeholder="{{.T "profile.search.placeholder"}}">
    {{if .Query}}<a href="/" aria-label="{{.T "profile.nomatch.all"}}" title="{{.T "profile.nomatch.all"}}">✕</a>{{end}}
    <button type="submit" class="primary">{{.T "profile.search.submit"}}</button>
  </form>
  {{/* 「共 N 条」以前写成"命中 6 条 · 共 20 条"，那个 20 是**档案总条目数**，
       读起来像"还有 20 条没显示"。说清是谁的总数。 */}}
  {{if .Query}}<p class="hits">{{.T "profile.hits" .Hits .Total}}</p>{{end}}
  <nav aria-label="{{.T "profile.nav.aria"}}">
    {{/* /admin 的路由真的存在（而且现在没管理权时会渲染登录页而不是死链），
         这枚徽章才有资格发链接。判据那一格由 httpapi 算，见上面的注释。 */}}
    {{/* 档案徽标：**点它回选择页换人**。

         2026-10-10 改判：它原来是一个 `<details>` 下拉，列着"别人"并让他们
         免 PIN 直达（`/switch to=<id>`），那是代管态的载体。那条路删掉之后，
         这份清单永远是空的——下拉点开只剩一个"退出"，成了"点了有反应但里面
         没东西"的界面。收成一个直接回选择页的表单：零脚本、不占常驻空间，
         形状一眼看得懂（自己的名字 → 点它换人）。

         仍然是表单而不是 href：`/switch` 是 POST-only 通路，首屏不许有
         href="/switch"，views_test.go 的死链钉守着这条。 */}}
    {{/* 档案徽标：印的是**档案名**，动作在 title 与 aria-label 里。

         2026-10-12 这一格改成"只说动作、不重复名字"，因为那时它左边那个 h1 印的
         就是同一个档案名——屏幕上出现两个「爸爸的台」。顶栏让给页面名之后，
         这句重复不成立了，而"我在谁的台上"这件事需要一常驻的落点（它原来是 h1）。
         所以名字回到这里，动作留给 title/aria-label。

         aria-label 用「%s · 换档案」而不是光「换档案」：可见文字必须是可及名的
         一部分（WCAG 2.5.3 Label in Name）——语音输入的人念的是屏幕上那句
         「爷爷奶奶的外婆家备用台」，一个只叫「换档案」的按钮他点不到。

         仍然是表单而不是 href：`/switch` 是 POST-only 通路，首屏不许有
         href="/switch"，views_test.go 的死链钉守着这条。 */}}
    <form method="post" action="/switch" class="profmenu">
      <input type="hidden" name="to" value="picker">
      <button type="submit" class="badge" title="{{.T "profile.switch.title"}}" aria-label="{{.T "profile.switch.named" .Profile.Title}}">{{.Profile.Title}}</button>
    </form>
    {{/* 管理入口（2026-10-12）：判据从「这个档案是不是管理员」换成「这次请求是不是
         带着一把真的管理权」（lb_admin）。于是管理员可以**一边用自己的档案看书签、
         一边仍带着管理权**，两者不再是同一个身份。 */}}
    {{if .HasAdmin}}<a class="badge" href="/admin">{{.T "profile.admin"}}</a>{{end}}
    <a class="badge" href="/prefs" id="lb-prefs-open" title="{{.T "prefs.open.title"}}">{{.T "prefs.open.label"}}</a>
    {{/* 回退入口：一条零 JS 链接（GET /revert），不需要 JS 也不需要令牌。
         它是"改坏了能退回去"这条承诺在页面上的**唯一**入口——revert 此前只有
         API 与命令行两条通路，页面上一个按钮都没有，而人点不到的东西不算承诺。

         **只在还有可退版本时画**（判据在 exec.go 的 HasSnapshots）：一条书签都没
         写过的档案，snapshots/ 是空的，点进去只有一句解释——那就是 §8.1 明写
         要避免的「点了没反应的东西」。*/}}
    {{/* 改动历史（2026-10-13）。这一枚**不判"有没有历史可看"**，与上面那枚
         回退不一样：回退在零快照时整张表单都不画，点进去确实什么都没有；
         而"还没有人动过这一份"本身就是历史页要回答的问题，不是一条死路。

         第二个理由是缓存：改 PIN、停用、重建这几类动作**不推进书签 rev**，
         却都会往审计线追一行。要按"有没有行"画这一枚，判据就得进渲染缓存键
         多出一维，而那一维天生滞后——为了一枚本来就该常驻的徽标不值得。 */}}
  </nav>
</header>
{{/* 管理横幅整块删掉了（2026-10-10 改判）：它那句「正在管理 X 的书签 · 由 Y 操作」
     是代管态的提醒，而代管这件事已经不存在了。留着一个永远不出现的横幅，
     下一个读模板的人会以为"进管理态"仍然是一条路——那正是 §11 记的那类
     "文档骗人"。sticky 那一族 CSS 随之没有挂载点，一并清掉。 */}}
{{/* 形态判一次、两处用：topbar 那条分组行在 .shell **外面**（它要横跨整幅），
     侧栏在 .shell **里面**（它占栅格第一列），所以这里没法写成 if/else。
     绑成一个变量就是"判据只有一份"的形状——写成两个独立的 eq/ne 条件等于把
     同一个判断抄两遍，将来加第三种形态时其中一处会静默失效。 */}}
{{$top := eq .Profile.Layout "topbar"}}
{{if $top}}
  {{/* 顶栏形态：分组行常驻顶栏下方。同一份 grouplist，两种挂法——
       判据（分组、计数、色点、锚点）只有一份。 */}}
  <nav class="gnav top" aria-label="{{.T "profile.nav.groups"}}">{{template "grouplist" .}}</nav>
{{end}}
<div class="shell">
{{if not $top}}
  {{/* aside 不带 aria-label：名字只给里面的 nav，一页一个具名导航地标。
       open 写死：桌面要它展开，平板断点下 summary 才现身当抽屉把手；
       键盘开合与可及性由原生 <details> 负责，零脚本，不补 role/aria-expanded 那类仪式。 */}}
  <aside class="side">
    <details class="drawer" open>
      <summary>{{.T "profile.summary.groups"}}</summary>
      <nav class="gnav" aria-label="{{.T "profile.nav.groups"}}">{{template "grouplist" .}}</nav>
    </details>
  </aside>
{{end}}
<main role="main">
{{if .Query}}
  {{if not .Bookmarks.Groups}}<p>{{.T "profile.nomatch" .Query}} <a href="/">{{.T "profile.nomatch.all"}}</a></p>{{end}}
{{else if .Empty}}
  <p>{{.T "profile.empty"}}</p>
  {{/* 导入卡片：只在**一条书签都没有**时出现（判据是 .Empty，exec.go 算一次，
       模板不做判断）。刻意**没有"导入过就别再问"的状态**——档案空就提示、
       有书签就不提示，判据只有"现在有几条书签"这一份；多一个"问过了"标记就要
       多一个字段、多一处两页可能说法的分家。

       它与 httpapi 的 importGuard（"非空档案不许导"）是同一条判据的两头：
       看得见这个入口的时候，它一定进得去。 */}}
  <p><a class="badge" href="/import">{{.T "profile.import.link"}}</a></p>
  <p class="hint">{{.T "profile.import.hint"}}</p>
{{end}}
{{range .Bookmarks.Groups}}
{{/* 节标题按**叶名 + 弱化的父路径**排版（2026-10-12）：导入把嵌套文件夹拍平成
     "工作 / 项目 A / 会议记录"这样的标题，于是三十个分组的标题全是路径串，
     而"工作"与"工作 / 项目 A"看上去是两组并列——它们本来是一家的。
     磁盘上的标题一个字都没改，拆成两半只是为了读起来有层级（exec.go 的
     pathSplit，判据只有那一份）；title 属性仍挂全名，截断与悬停都不丢信息。 */}}
<section aria-labelledby="g-{{.ID}}" data-gid="{{.ID}}" data-layout="{{.Layout}}" data-depth="{{.Depth}}"{{if .AccentCSS}} style="--sec-accent:{{.AccentCSS}};--d:{{.Depth}}"{{else}} style="--d:{{.Depth}}"{{end}}>
  <h2 id="g-{{.ID}}" data-group="{{.ID}}" title="{{.Title}}">{{with .Parents}}<span class="sec-path">{{.}} /</span>{{end}}<span class="sec-leaf">{{.Leaf}}</span></h2>
  <ul class="{{if eq .Layout "tiles"}}tiles{{else}}rows{{end}}">
  {{range .Items}}
    {{/* data-desc / data-alias / data-tags 是给 ⌘K 的那一屏用的：面板从前只比名字与
         地址，而整页搜索（filter.go 的 matchItem）比名字/地址/说明/每个别名/每个标签，
         分组标题命中还带出整组——同一台机器同一个词，一个说"没有"，另一个搜出 8 条。
         现在两边读同一组字段。多个值用 `&#10;`（换行）连接而不是空格：标签与别名
         自己可能带空格，用空格当分隔会把一个标签拆成两个、还会跨两个标签误配。
         空的就不写（1000 条那一份每一格都写会白吃一屏字节）。
         data-icon-name 是给编辑模态的：那一格要能说出"现在用的是哪一个"，而图标名
         在屏上只是一个小图形，DOM 里没有它写字的地方。**名字不能写成 data-icon**：
         Go 的 html/template 把 `icon` 当 URL 属性，`data-icon` 的后缀撞上它，
         值会被换成 #ZgotmplZ（实测，复现见 .superpowers/tmp/dp9/tmplattr）。
         带 `-name` 后缀就不在名单里，值原样出去。 */}}
    <li data-item="{{.ID}}"{{if .Desc}} data-desc="{{.Desc}}"{{end}}{{if .Alias}} data-alias="{{range .Alias}}{{.}}&#10;{{end}}"{{end}}{{if .Tags}} data-tags="{{range .Tags}}{{.}}&#10;{{end}}"{{end}} data-icon-name="{{.Icon}}">
      {{if .External}}
        <span class="plain">
          {{template "icon" .}}
          <b title="{{.Name}}">{{.Name}}</b>
        <span class="addr">
          <code title="{{.URL}}">{{.URL}}</code>
          {{/* 不可点的地址（chrome:// 、file:// …）这一格。
               badge 上的 ext 是**给 app.js 的钩子**，不是样式：那一颗徽标由模板
               渲染（关掉 JS 时它仍是那一行唯一一句能读懂的话——「浏览器不让页面
               打开这种地址」是真的），而**能按的复制键由 app.js 就地把它换成**。
               模板里不渲染那颗按钮，同 §8.1 那条「点了没反应的东西不进界面」
               与顶栏「＋ 添加」同一处置（app.js 头部同一句纪律）。
               判据只有一处：地址取同一个 <code> 的 textContent，与 ⌘K 搜外部
               条目时读的是同一处，模板与脚本都不再抄一份 URL。

               **地址与两枚键同住这一行**（2026-10-13 实拍后改判）。从前是地址一行、
               复制键在它右端、把手绝对定位在名字行右上角——看起来分处两行就
               不可能相交，实拍恰恰相反：把手 `top:6px` 高 44px 落到 y 6–50，
               而第二行从 y 32 起算，**纵向重叠 18px**（用户实拍图：两枚键叠在
               右下角）。把两枚键收进这一行、地址给它们让出右边，才是真的不相交，
               而不是"算下来应该不相交"。 */}}
          <span class="badge warn ext" title="{{$.T "profile.external.title"}}">{{$.T "profile.external.badge"}}</span>
        </span>
          {{if .Missing}}<span class="badge" title="{{$.T "profile.icon.title"}}">{{$.T "profile.icon.missing"}}</span>{{end}}
          <span class="tags-row">{{range .Alias}}<span class="tag">{{.}}</span>{{end}}{{range .Tags}}<span class="tag">{{.}}</span>{{end}}</span>
        </span>
      {{else}}
        <a class="card" href="{{.URL}}"{{if $.Bookmarks.OpenInNewTab}} target="_blank" rel="noopener noreferrer"{{end}}>
          {{template "icon" .}}
          <b title="{{.Name}}">{{.Name}}</b>
          {{with .Desc}}<i>{{.}}</i>{{end}}
          {{if .Missing}}<span class="badge" title="{{$.T "profile.icon.title"}}">{{$.T "profile.icon.missing"}}</span>{{end}}
          <span class="tags-row">{{range .Alias}}<span class="tag">{{.}}</span>{{end}}{{range .Tags}}<span class="tag">{{.}}</span>{{end}}</span>
        </a>
      {{end}}
    </li>
  {{end}}
  </ul>
</section>
{{end}}
</main>
</div>
{{with .Bookmarks.Footer}}<footer><p>{{.}}</p></footer>{{end}}
{{/* ⑤ 的第一个真字节。**只有这一页引它**——选择页/引导页/坏档页/管理页继续零脚本，
     它们的形态里没有"加书签"这回事，引入 JS 只会让 §7.2 的判据更难守。
     type=module + defer：模块天然 defer，且不污染全局（§7.2 那个 CSP 下 'self'
     仍然放行，因为它是外部文件而不是内联脚本）。 */}}
<link rel="stylesheet" href="{{.AppCSS}}">
  {{/* 页内嵌的那一份浮层：JS 开着时点顶栏「台面」弹的是它；JS 关着时那颗
       `<a href="/prefs">` 正常跳去独立页。两条路渲染的是同一个 define。

       **空壳**（内容由 app.js fetch `/prefs` 后注入）：面板约 2 KB，而 §7.3 那条
       操作线管的是每一页的首屏——只是来看书签的人不该背这 2 KB。

       tabindex="-1"：浮层打开后焦点要落在面板自己身上（读屏先念可及名），
       而 div 默认不可聚焦。可及名走 aria-labelledby 指向注入进来的那个 h2，
       不用 aria-label 把同一句话写两遍。 */}}
  <div class="sheet" id="lb-prefs" hidden tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="lb-prefs-h"></div>
<script type="module" src="{{.AppJS}}"></script>
</body>
</html>{{end}}
{{/* 图标三级兜底（spec §5）：内联 SVG > 缓存 favicon 的 <img> > 首字母色块。
     第三方字节（缓存 favicon）永远只走 <img>，绝不内联。SVG 由 svgMarkup
     拼好（本案唯一拼 markup 的地方），这里只负责按三取一端出去。
     条目身上只带 --chip-h 这一个数（int，无字符串可逃）；分组色的**判据**只有
     validatedAccent 一份，挂载点两处——section 的 --sec-accent 与侧栏那枚色点
     （同一个属性名，没有第三个），条目身上一个都不许有——模板不做判色。
     这个 define 必须与 "profile" 平级：Go 模板不许嵌套 define。 */}}
{{define "icon"}}
{{- if .SVG}}
{{.SVG}}
{{- else if .Img}}
<img class="ic-img" src="{{.Img}}" alt="" aria-hidden="true" width="22" height="22">
{{- else}}
<span class="ic" style="--chip-h:{{.ChipHue}}" aria-hidden="true">{{.Letter}}</span>
{{- end}}
{{- end}}
{{/* 分组导航：锚点复用 section 已有的 id="g-<id>"（§8 的 section 本来就带
     aria-labelledby，两边指同一个东西）。计数取的是当前渲染的那份数据，
     所以带 q 时它天然是命中数——不需要第二个数。
     三件套（分组名 + 计数 + 色点）是设计 §7 与权威源 §8.2 一起列的，少一件
     就是少一件。色点走同一个 --sec-accent 属性名：判色仍只有 validatedAccent
     一份（exec.go 的 groupView.Accent），只是它现在有两个挂载点（section 与
     它的侧栏行），条目身上照旧一个都不许有——证人见 icon_test.go。
     没有 accent 的分组不发这一格——`{{with}}` 就是"没设色就不画点"。
     这个 define 必须与 "profile" 平级：Go 模板不许嵌套 define（同 "icon" 那条约束）。 */}}
{{define "grouplist"}}
<ul>
{{/* 侧栏走的是 **Nav 那棵树**，不是 Groups 那个平表（2026-10-12）：一份真实导出
     三十个文件夹，标题全是"工具 / 同步 / 脚本"这样的串，侧栏于是是三十行长文本，
     而看不出哪几个是一家的。树由 groupNav 在 Go 侧算好——判据只有 pathSplit 一处，
     模板不拼路径、不数层级。

     两类格子：真实分组（IsGroup）带锚点、计数与色点；合成父级只有一段标签，
     不可点、没计数。带 ?q= 时计数天然是命中数（Groups 已被过滤），不需要第二个数。

     深度缩进靠 --d 那一个整数（CSS 里 `--d*12px`），不用嵌套 <ul>：窄屏那条
     横向分组带用的是同一份数据，嵌套列表在横向排布里没法表达，而一个整数在
     两种形态里都成立。 */}}
{{range .Bookmarks.Nav}}
  {{if .IsGroup}}
  {{/* 侧栏这一格**只印叶名**（2026-10-12）：缩进已经说明了层级，再把父路径
       写进文字就是同一件事说两遍——而 206px 的侧栏里两遍都放不下，
       实测那一行被截成"工作 / 项目… 会议…"（两头各一个省略号）。
       完整路径仍在 title 里：悬停能看见，截断不等于信息丢了。 */}}
  {{/* **`{{with .Accent}}` 里 `.` 已经变成那个字符串了**（Go 模板的 with 会换掉点号），
       所以 `.AccentCSS` 在里面根本取不到——实测报的是
       `can't evaluate field AccentCSS in type string`。
       而 `$` 是**模板根**（整个页面那一份），不是循环项——用 `$` 会取到错的东西。
       正确写法是 `{{range}}` 的循环变量：给它起个别名，with 之后仍用那个别名。 */}}
  {{$n := .}}
  <li style="--d:{{.Depth}}"><a href="{{.Href}}" title="{{.Label}}">{{with $n.Accent}}<i class="dot" style="--sec-accent:{{$n.AccentCSS}}" aria-hidden="true"></i>{{end}}<span>{{.Leaf}}</span><b class="cnt">{{.Count}}</b></a></li>
  {{else}}
  <li class="nav-parent" style="--d:{{.Depth}}"><span>{{.Leaf}}</span></li>
  {{end}}
{{end}}
</ul>
{{end}}

{{/* ── 台面面板（2026-10-13）────────────────────────────────────────────────
     顶栏这一格改的全是**同一件事**：这一页怎么排、叫什么、能退到哪。
     之前它们是六颗散着的控件（改名 details、主题循环、视图三颗、档案形态、
     回退、改动历史），顶栏两行都塞不下，于是每一颗各自解释自己。

     收进一个面板之后有两件事同时变好：
       1. **一个入口**：顶栏右侧只剩一颗「台面」，其余五件事在这一屏里排成一列，
          人看得见"这些是一伙的"，也就不用记哪颗在哪。
       2. **一处可优化**：三组三态/两态的键现在形状完全一致（都是一组 pressed 单选钮），
          以前它们是三种不同的控件——改名是一张 details 表单、主题是一颗循环键、
          视图与形态才是 pressed 单选钮。同族不同形是最难维护的一种排法。

     主题那一颗从**三态循环**改成三颗显式键：循环键只能说"当前是哪一档"，
     而面板里三个选项并排摆着，直接挑就行，"跟随系统"（auto）这个选项也不再是
     一个只能按顺序绕回去才能回来的东西。

     `prefs-panel` 是**共用块**：`GET /prefs` 那张独立页与页内嵌浮层渲染的是同一份
     标记（它们在本文件里，不跨文件——`icon` 在 profile.tmpl 与 picker.tmpl 里重名，
     把两个模板并成一个集合会让其中一份被静默覆盖）。
     每一行仍然是**普通的 form POST /prefs**：面板是 JS 画的，改设置不是。
     入口是 `<a href="/prefs">`：JS 关着时它就是一次正常跳转。 */}}
{{define "prefs-panel"}}
<section class="prefs">
  <h2 id="lb-prefs-h">{{.T "prefs.heading"}}</h2>
  <p class="hint">{{.T "prefs.explain"}}</p>

  {{/* 每一行都是**一张独立的表单**：一次按下只改一件事，于是"改坏了退回上一档"
       永远是一颗键的事，不需要"提交"这一步。

       改名那一行用 `<label for>` 而不是 `<span>` + 内层 `<label>`：可见文字
       **就是**输入框的可及名（WCAG 2.5.3），而且点那五个字会直接把光标送进
       输入框。内层再写一遍「这一页的名字」是同一句话说了两遍。 */}}
  {{/* ── 这一页长什么样 ──────────────────────────────────────────────────
       2026-10-14 参考 Flare 那一屏改排版：从「标签在左、控件在右」改成
       「**说明在上、控件在下**」。改的理由是实测出来的那一处：从前每一行的
       解释只在**悬停 title** 里，而屏上放不下的那句（分组导航的 sidebarNote）
       只能另起一行，于是它与那一行的两颗键**视觉脱节**——读起来像面板底部多
       了一段不相干的话。Flare 那一屏把每一项做成「小字说明 + 控件」成对，
       于是说明有地方待、控件拿满整行的宽，而它与键自己的 title 不冲突
       （title 答"这一颗"，说明答"这一格"）。

       **每行仍然是独立的表单、按下即改**：那一层没动。Flare 那个整页一个
       「保存修改」在这里赢不了——改错了要撤销就得先存一版错的，而
       「按一下只改一件事」是本面板从一开始就有的那条。 */}}
  <h3 class="prefs-sec">{{.T "prefs.sec.look"}}</h3>

  <form method="post" action="/prefs" class="prefs-row">
    <div class="prefs-field">
      <label class="prefs-label" for="lb-page-title">{{.T "prefs.rename"}}</label>
      <p class="prefs-hint">{{.T "prefs.rename.hint"}}</p>
      <div class="prefs-ctl">
        <input class="fld" id="lb-page-title" name="title" type="text"
          maxlength="60" autocomplete="off"
          value="{{.Profile.PageTitle}}" placeholder="{{.T "profile.title.default"}}">
        <button type="submit" class="primary">{{.T "profile.rename.save"}}</button>
      </div>
    </div>
  </form>

  <form method="post" action="/prefs" class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.view"}}</span>
      <p class="prefs-hint">{{.T "prefs.view.hint"}}</p>
      <div class="prefs-keys">
        <button type="submit" name="view" value="groups" aria-pressed="{{if eq .Profile.View "wall"}}false{{else if eq .Profile.View "dense"}}false{{else}}true{{end}}" title="{{.T "profile.view.groups.title"}}">{{.T "profile.view.groups.label"}}</button>
        <button type="submit" name="view" value="wall" aria-pressed="{{if eq .Profile.View "wall"}}true{{else}}false{{end}}" title="{{.T "profile.view.wall.title"}}">{{.T "profile.view.wall.label"}}</button>
        <button type="submit" name="view" value="dense" aria-pressed="{{if eq .Profile.View "dense"}}true{{else}}false{{end}}" title="{{.T "profile.view.dense.title"}}">{{.T "profile.view.dense.label"}}</button>
      </div>
    </div>
  </form>

  <form method="post" action="/prefs" class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.layout"}}</span>
      {{/* 「紧凑档下这一列不画」**接在这一格的说明后面**，而不是从前那样另起一行
           （`{{if .Compact}}<p class="hint">…</p>{{end}}`）。它解释的是**这一格**
           的后果，摆在说明位里才读得出"这几句说的就是上面这两颗键"；另起一行时它
           与那两颗键视觉脱节，读起来像面板底部多了一段不相干的话。 */}}
      <p class="prefs-hint">{{.T "prefs.layout.hint"}}{{if and (eq .Profile.Layout "sidebar") .Compact}} {{.T "prefs.layout.sidebarNote"}}{{end}}</p>
      <div class="prefs-keys">
      {{/* 「侧栏」这两个字**在紧凑档下也不改**（2026-10-14 改判）：这一格有两条
           不变量——TestPrefs_开关的标签稳定而状态走aria 钉的是"可见文字稳定，
           状态走 aria-pressed"，而"标签随另一格的值变"正是那条要挡的走样。
           人要能指着"写着侧栏的那颗"说话，而那颗一直都在。
           "紧凑档下这一列不画"这件事写进**下面那一句说明**——它是解释，不是控件名。 */}}
        <button type="submit" name="layout" value="sidebar" aria-pressed="{{if eq .Profile.Layout "topbar"}}false{{else}}true{{end}}" title="{{.T "profile.layout.toSidebar"}}">{{.T "prefs.layout.sidebar"}}</button>
        <button type="submit" name="layout" value="topbar" aria-pressed="{{if eq .Profile.Layout "topbar"}}true{{else}}false{{end}}" title="{{.T "profile.layout.toTopbar"}}">{{.T "prefs.layout.topbar"}}</button>
      </div>
    </div>
    {{/* 这一句只在**屏上真的没画那一列**时才出现，判据是
       `layout=sidebar` **且** view 是紧凑档——与 base.css 那两条
       `[data-profile-layout=sidebar][data-profile-view=…]` 是同一个事实。
       从前它是 `.Compact`（只看 view），而 `topbar + dense` 那一档**顶栏已经在
       导航了、侧栏压根没画**，面板却还在说"选『侧栏』时不画那一列"——一句为
       另一档写的解释落在这一档，读起来像"我按了侧栏它就不见了"。
       **判据与它解释的那段 CSS 必须同源**：解释一个条件，却在另一个条件成立时
       出现，那比不解释更坏。 */}}

  </form>

  <form method="post" action="/prefs" class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.theme"}}</span>
      <p class="prefs-hint">{{.T "prefs.theme.hint"}}</p>
      <div class="prefs-keys">
        <button type="submit" name="theme" value="auto" aria-pressed="{{if eq .Profile.Theme "auto"}}true{{else}}false{{end}}" title="{{.T "prefs.theme.auto.title"}}">{{.T "profile.theme.auto"}}</button>
        <button type="submit" name="theme" value="dark" aria-pressed="{{if eq .Profile.Theme "dark"}}true{{else}}false{{end}}" title="{{.T "prefs.theme.dark.title"}}">{{.T "profile.theme.dark"}}</button>
        <button type="submit" name="theme" value="light" aria-pressed="{{if eq .Profile.Theme "light"}}true{{else}}false{{end}}" title="{{.T "prefs.theme.light.title"}}">{{.T "profile.theme.light"}}</button>
      </div>
    </div>
  </form>

  {{/* ── 背景：这一页自己的那张图 ────────────────────────────────────────────
       上传/换一张、移除、暂时不显示，三个动作是**三张独立的表单**——它们
       同落一个端点 `POST /prefs/background`，但字段不同，而一次按下只改一件事
       （与上面「分组」那一节同一条纪律）。

       文件那一格必须 `enctype=multipart/form-data`：文件走不了 urlencoded，
       而**这也是它不并进 POST /prefs 的原因**——那一条的字段名单是
       auto|dark|light|view|title，把一张几 MB 的图塞进去，那句 422 就会开始
       管到不属于它的东西（判据见 httpapi/prefs.go）。

       「暂时不显示」是这一格里最容易被当成多余的：它不改文件、也不删，
       只是**不画**。家里来客人时不想让照片挂在电视墙上，而不想删掉重传。
       它存在 profile.json 里而不是浏览器本地存储——电视上关了，手机上也该关。 */}}
  <div class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.bg"}}</span>
      <div class="prefs-bg">
      {{if .BackgroundFile}}
      {{/* 预览图用的是**同一个端点**：它只发给会话所指的那一份，于是这一格
           同时也是"这张图真的还在盘上"的证人（图没了就是 404 一张空图，
           而面板其余部分照常可用——坏背景不许挡台面）。
           判据是 BackgroundFile（盘上有没有）而不是 Background（画不画）——
           后者在「暂时不显示」时是空的，于是这一节会连同「恢复显示」一起消失，
           屏上读作"我的背景没了"。 */}}
      <img class="prefs-bg-preview" src="{{.BackgroundFile}}" alt="" width="160" height="90" loading="lazy">
      <p class="hint">{{if .Profile.BackgroundOff}}{{.T "prefs.bg.hidden"}}{{else}}{{.T "prefs.bg.on"}}{{end}}</p>
      {{else}}
      <p class="hint">{{.T "prefs.bg.none"}}</p>
      {{end}}
      <div class="prefs-keys">
        <form method="post" action="/prefs/background" enctype="multipart/form-data" class="prefs-bg-upload">
          {{/* 真 input 透明铺在按钮上（见 base.css .prefs-bg-file 那段），所以屏上露出来的
               是一颗与全站同脸的 .fld，而读屏念到的仍是那个 label 的可及名。
               **三样都要在**：input（提交与点开对话框）、label 的可及名（这一格是背景图，
               不是"文件名"）、以及下面那颗可见按钮（人点的那个形状）。少一样症状各不相同：
               少 input 点不开，少 label 读屏只念"选择文件"，少按钮屏上就还是原生控件。 */}}
          <label class="prefs-bg-file">
            <span class="prefs-visually-hidden">{{.T "prefs.bg.pick"}}</span>
            <span class="fld" aria-hidden="true">{{.T "prefs.bg.chooseFile"}}</span>
            <input type="file" name="file" accept="image/png,image/jpeg,image/webp,image/gif">
          </label>
          <button type="submit" class="fld">{{if .BackgroundFile}}{{.T "prefs.bg.replace"}}{{else}}{{.T "prefs.bg.upload"}}{{end}}</button>
          {{/* 选中的文件名。原生控件收起之后它没有别的地方可显示，所以自己管一行，
               `.prefs-bg-picked:empty{display:none}` 让没选时不占位。
               **这一行只在 JS 开着时才有内容**：app.js 在档案页会 fetch `/prefs`
               注入同一份面板，那时它给这一行填上选中的文件名；而 `GET /prefs`
               那张零 JS 的独立页里没人填它，于是看不见选了什么（表单照样能提交，
               提交后这一节会重画并给出结果）。这是"用真按钮换掉原生控件"的代价，
               明说在此，不假装它没有——而两处界面共用同一个 define，
               少一个出口好过两个出口长得不一样。 */}}
          <span class="prefs-bg-picked" aria-live="polite"></span>
        </form>
        {{if .BackgroundFile}}
        {{if .Profile.BackgroundOff}}
        <form method="post" action="/prefs/background">
          <button type="submit" name="hidden" value="0" class="fld">{{.T "prefs.bg.show"}}</button>
        </form>
        {{else}}
        <form method="post" action="/prefs/background">
          <button type="submit" name="hidden" value="1" class="fld">{{.T "prefs.bg.hide"}}</button>
        </form>
        {{end}}
        <form method="post" action="/prefs/background">
          <button type="submit" name="remove" value="1" class="fld danger" title="{{.T "prefs.bg.removeTitle"}}">{{.T "prefs.bg.remove"}}</button>
        </form>
        {{end}}
      </div>
      <p class="hint">{{.T "prefs.bg.hint"}}</p>
      </div>
    </div>
  </div>

  {{/* 「回退与历史」不是设置，是**两个出口**——它排在上面四行"这一页长什么样"
       （改名/怎么看/分组导航/主题/背景）之后，而不在它们中间：
       2026-10-14 之前背景那一节落在它下面，于是这屏读成
       「四行设置 → 两个出口 → 又一行设置」，一屏里设置与出口各断一次。 */}}
  {{/* 「点开书签」：**当前标签页 / 新标签页**（openInNewTab）。它排在「分组」那节
       上面而不是上面那几行里，因为它改的是**书签文档**（走 batch：rev + 快照 +
       审计，能在「回退」里退回来），而上面几行改的是台面偏好（只写 profile.json）。
       两族落点不同，混在一屏里却不说清哪一族有快照，人按错了会以为都能退。 */}}
  <form method="post" action="/prefs/tabs" class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.tabs"}}</span>
      <p class="prefs-hint">{{.T "prefs.tabs.hint"}}</p>
      <div class="prefs-keys">
        <button type="submit" name="tabs" value="0" aria-pressed="{{if .Bookmarks.OpenInNewTab}}false{{else}}true{{end}}" title="{{.T "prefs.tabs.sameTitle"}}">{{.T "prefs.tabs.same"}}</button>
        <button type="submit" name="tabs" value="1" aria-pressed="{{if .Bookmarks.OpenInNewTab}}true{{else}}false{{end}}" title="{{.T "prefs.tabs.newTitle"}}">{{.T "prefs.tabs.new"}}</button>
      </div>
    </div>
  </form>

  {{/* 两个出口（回退 / 改动历史）**不是设置**，所以独立成节而不是夹在设置行
       中间 —— 那一层分组从 2026-10-14 起就在，但那时只有一句 `prefs.elsewhere`
       当标签，读者仍要自己判断"这两颗是设置还是别的"。 */}}
  <h3 class="prefs-sec">{{.T "prefs.sec.out"}}</h3>
  <div class="prefs-row">
    <div class="prefs-field">
      <span class="prefs-label">{{.T "prefs.elsewhere"}}</span>
      <div class="prefs-keys">
      {{if .HasSnapshots}}<a class="badge" href="/revert" title="{{.T "profile.revert.title"}}">{{.T "profile.revert"}}</a>{{end}}
        <a class="badge" href="/history" title="{{.T "history.link.title"}}">{{.T "history.link"}}</a>
      </div>
    </div>
  </div>

  {{/* ── 分组：颜色 + 这一组自己的排法 ──────────────────────────────────────
       这是"能配却没有出口"的那一格。`ops` 一直认 `groups/<id>/accent` 与
       `groups/<id>/layout`，而界面上一个入口都没有——于是每个类目的色块都是
       CSS 的 `--sec-accent,var(--accent)` 兜底值，一整页同一个蓝。

       **一个分组一张表单**，一张表单里两种意图。分开它们的判据是**名字**，不是
       "HTML 只提交被按下的那个控件"——那句话漏了命名过的输入框：它每一次提交都
       跟着走（实测按色块交出两个 `accent`、按磁贴交出 `layout` 加一个颜色）。
       所以取色器那一格叫 `custom`，那颗动作键带 `name=apply_custom`：按色块只交
       得出 `accent`，按排法只交得出 `layout`，只有按下那颗动作键才交得出颜色。
       于是"一次按一下只改一件事"在**零 JS 的整页通路上**也成立。

       落点是 `POST /prefs/group`，不是 `/prefs`：这两个字段落在
       bookmarks.json 的分组上，走的是 applyBatch 那条书签写通路（快照、审计、
       rev 一道闸不少），而 `/prefs` 只写 profile.json 的台面偏好。把两边混在
       一个端点里，422 的"至少给一个字段"就会开始管到不属于它的东西。 */}}
  {{/* 分节头与另两节**同一种形状**（2026-10-14 实拍后改）。原来这一节用的是
       `<div class="prefs-groups-head">` + 一个 `.prefs-label`：那条 div 是
       `display:flex` 且 `align-items:baseline`，于是「分组」与它那句长说明**并排挤在
       同一行**上（1440 实拍：标签 13px、说明 12px，中间 10px）。另两节是
       `h3.prefs-sec`——13px 大写字、带一条分隔线、独占一行。于是同一屏里三个
       分节头长得像三种东西，而"分组"那一节恰好是**唯一一节有分隔线以外的东西**。
       判据是"它是分节头"，所以它就该与另两个分节头共用同一个类。 */}}
  <h3 class="prefs-sec">{{.T "prefs.groups"}}</h3>
  <p class="prefs-hint">{{.T "prefs.groups.hint"}}</p>

  {{if .PrefGroupsBroken}}
    <p class="hint" data-prefs-groups-broken>{{.PrefGroupsBroken}}</p>
  {{else if not .PrefGroups}}
    <p class="hint">{{.T "prefs.groups.empty"}}</p>
  {{else}}
  <div class="prefs-groups">
    {{range .PrefGroups}}
    {{/* Accent 过 validatedAccent 之后：盘上写坏了的值到不了 style 属性上。
         自定义那一格的输入框用盘上这个值当默认，于是「改回原来那个」是一次点击。 */}}
    {{$cur := .Accent}}
    {{/* 组名要在这里存成变量：色板那一圈 range 会把 `.` 换成
         颜色字符串，而 `$` 是页根（没有 Title 这一格）。 */}}
    {{$gname := .Title}}
    {{$onPalette := false}}
    {{range $.PrefPalette}}{{if eq . $cur}}{{$onPalette = true}}{{end}}{{end}}
    <form method="post" action="/prefs/group" class="prefs-group">
      <input type="hidden" name="group" value="{{.ID}}">
      {{/* 名字与**这一组自己的排法**同一行，色板另起一行。这么分是因为
           "这一组叫什么、用哪种排法"是一句话，而九颗色块与它们放在同一行
           就得折成两行——五个分组的面板已经两屏高，四十个分组时那是一堵墙。
           排法那两颗跟着名字走，读起来也正好是"这一组：磁贴"。 */}}
      <b class="prefs-group-name" title="{{.Title}}">
        <i class="prefs-swatch-preview" style="--sw:{{if .Accent}}{{.Accent}}{{else}}var(--accent){{end}}" aria-hidden="true"></i>
        <span>{{.Title}}</span>
      </b>
      <div class="prefs-keys prefs-group-shape">
        {{/* 每一颗键的可及名都带上"这一组叫什么"：一块面板里 13 个名字各重复
             六遍（磁贴/单列/用这个颜色/跟随主色/八色/自定义颜色 ×6 组），读屏
             听得到"按下/没按下"，听不到"这是哪一组"。屏上仍然只印短标签——
             WCAG 2.5.3 要的是可及名**包含**看得见的字，"NAS 与存储 · 磁贴"包得住。 */}}
        <button type="submit" name="layout" value="tiles"
          aria-pressed="{{if eq .Layout "list"}}false{{else}}true{{end}}"
          aria-label="{{$gname}} · {{$.T "app.layout.tiles"}}"
          title="{{$.T "app.layout.tiles"}}">{{$.T "app.layout.tiles"}}</button>
        <button type="submit" name="layout" value="list"
          aria-pressed="{{if eq .Layout "list"}}true{{else}}false{{end}}"
          aria-label="{{$gname}} · {{$.T "app.layout.rows"}}"
          title="{{$.T "app.layout.rows"}}">{{$.T "app.layout.rows"}}</button>
        {{/* 自定义：原生取色器收任意 hex（色板**不是白名单**），这一格就是那条路的
             入口。按下的不是色块本身而是这颗「用这个颜色」，免得调色器一开就立刻
             改掉别人的东西。它跟着磁贴/单列待在名字那行，是因为色板那一行需要
             512px（10 颗 ×44 + 9 个 gap ×8）——硬塞进同一行只会折成三行。
             **这颗键不是开关**：它没有"按下/没按下"可言，只有"按下去会发生什么"，
             所以不带 aria-pressed；"现在生效的是自定义那一格"这件事由取色器自己
             身上那一圈 `data-active` 说（下面那一格）。 */}}
        <button type="submit" class="prefs-swatch-apply" name="apply_custom" value="1"
          title="{{$.T "prefs.groups.customSave"}}" aria-label="{{$gname}} · {{$.T "prefs.groups.customSave"}}">{{$.T "prefs.groups.customSave"}}</button>
      </div>
      <div class="prefs-keys prefs-group-colors">
        {{/* 「跟随页面主色」不是"无色"，而是**没设色**这个状态的按钮**：
             它是那一行的默认值，所以它得是一颗能被按的键——否则从自定义色
             回不到默认去，色板就成了只能进不能出的单向门。 */}}
        <button type="submit" name="accent" value="" class="prefs-swatch prefs-swatch-none"
          aria-pressed="{{if $cur}}false{{else}}true{{end}}"
          aria-label="{{$gname}} · {{$.T "prefs.groups.accentDefault"}}" title="{{$.T "prefs.groups.accentDefault"}}"></button>
        {{range $i, $c := $.PrefPalette}}
        <button type="submit" name="accent" value="{{$c}}" class="prefs-swatch" style="--sw:{{$c}}"
          aria-pressed="{{if eq $cur $c}}true{{else}}false{{end}}"
          aria-label="{{$gname}} · {{index $.PrefPaletteNames $i}}" title="{{index $.PrefPaletteNames $i}}"></button>
        {{end}}
        {{/* 这一格**必须**叫 custom 而不是 accent：命名过的输入框每一次提交都跟着走，
             与色板那颗键同名就会出现两个 `accent`——那正是把整条零 JS 通路堵死的形状
             （实测：按色块 422 一屏裸 JSON）。它只在同一次提交里带上 `apply_custom`
             时才说话，判据在 httpapi/prefs.go 那一处。 */}}
        <input type="color" class="prefs-color" name="custom"
          {{if and $cur (not $onPalette)}}data-active="1"{{end}}
          value="{{if $cur}}{{$cur}}{{else}}#4c8dff{{end}}"
          aria-label="{{$gname}} · {{$.T "prefs.groups.customLabel"}}{{if and $cur (not $onPalette)}}{{$.T "prefs.groups.customOn"}}{{end}}"
          title="{{$.T "prefs.groups.customLabel"}}">
      </div>
    </form>
    {{end}}
  </div>
  {{end}}
</section>
{{end}}

{{define "prefs-page"}}<!doctype html>
<html lang="{{.Lang}}"{{with .Theme}} data-theme="{{.}}"{{end}}{{with .Background}} data-bg="1" style="background-image:linear-gradient(var(--scrim),var(--scrim)),url({{.}})"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.T "prefs.pageTitle"}} · {{.Profile.Title}}</title>
<style>{{.CSS}}</style>
{{/* app.css 只为那一格输入框与按钮族而引：面板的骨架（行、标签、键组）在
     base.css 里，因为**没有 JS 时这一页照样要长这样**——降级路径不能是个
     没穿衣服的版本。这一页不带 AppJS：它没有浮层之外的交互。 */}}
{{with .AppCSS}}<link rel="stylesheet" href="{{.}}">{{end}}
</head>
<body>
{{template "prefs-panel" .}}
<nav class="prefs-back"><a class="badge" href="/">{{.T "common.back.home"}}</a></nav>
</body>
</html>
{{end}}

