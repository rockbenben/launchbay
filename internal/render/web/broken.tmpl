{{define "broken"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.T "broken.title"}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<main role="main" class="chooser">
  <h1>{{.T "broken.h1"}}</h1>
  {{/* 两层文案（spec §12）：第一句是人话，细节收进 details。
       Reason 由 store 给（filepath.Base + 行号），这里不改写、不截断、
       不拼路径——同一段字节也是 API 503 的 detail，两处共用一份真相。

       2026-10-12：这两句从前是**三个碎片拼出来的**（`档案` + `%s 现在打不开，` +
       `其它档案不受影响。`，中间还夹着两个 <b>）。英文那侧读出来是
       "Profile dad will not open. Other profiles are unaffected."——动词与主语
       被拼接拆散、句中多出一个句号，而中文那句以「，」收尾等着被续写。
       一句话现在是一个键：id 走 %s 进句子内部，两种语言各自说完整的一句。 */}}
  <p>{{.T "broken.p.a" .ProfileID}}</p>
  <p>{{.T "broken.p.b"}}</p>
  <p>{{.T "broken.p2"}}</p>
  <details class="tech">
    <summary>{{.T "broken.summary"}}</summary>
    <pre>{{.Reason}}</pre>
  </details>
  {{/* 这一页从前没有任何出口：读到这里的人只能按浏览器的后退，而他刚按下的那个
       链接就是把他带到这儿的。给一条真的出路——回选择页换一份进（走 /switch 的
       表单通路，清会话 cookie；写成 href="/switch" 是死链，那条路只收 POST）。 */}}
  <form method="post" action="/switch" class="act">
    <input type="hidden" name="to" value="picker">
    <button type="submit" class="primary">{{.T "broken.back"}}</button>
  </form>
</main>
</body>
</html>{{end}}
