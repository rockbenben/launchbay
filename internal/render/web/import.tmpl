{{define "import"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Heading}} · launchbay</title>
<style>{{.CSS}}</style>
</head>
<body>
<header>
  <h1>{{.Heading}}</h1>
  <nav aria-label="{{.T "common.back.aria"}}"><a class="badge" href="/">{{.T "common.back.home"}}</a></nav>
</header>
<main role="main">
  {{/* 提示放在最前：读屏的人不该先听完一屏说明才知道刚才那一步没成。
       与选择页/管理页同一条理由。 */}}
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}

  {{if eq .Mode "report"}}
    {{/* 报告**不许折叠**：这一页存在的全部意义就是让人读完再决定。
         `.tech` 是**容器**、换行由 `.tech pre{white-space:pre-wrap}` 给——类要挂
         在外层那个元素上。挂到 <pre> 自己身上时那条规则匹配不上，报告就按默认的
         pre 不换行、横向滚出去，长行右边直接被切掉（浏览器实测才发现）。 */}}
    {{/* 这一句从前由 5 个碎片拼成（intro.a/n/b/m/c），为的是把两个数字各自包进 <b>。
         代价写在屏上：`intro.b` 的值是「 条书签、」，接上 `<b>3</b>` 就变成
         「、 3」——全角顿号后面多一个空格，而那是这一族标点自己带的空隙。
         现在一句话一个键、数字走 %d 进句子内部（与 profile.hits 同一形状），
         <b> 让位给整句的分量：这一整行本来就是这一页的结论。 */}}
    <p><b>{{.FileName}}</b>{{.T "import.file.sep"}}{{.T "import.intro" .Count .Groups}}
       {{/* 没能进来的单独说一句：只报"会加几条"会让人以为文件里就这么多书签，
            而少的那些去了哪里只有报告知道。 */}}
       {{if .Skipped}}{{.T "import.skipped" .Skipped}}{{end}}</p>
    {{/* **人话摘要在上，完整报告在下**（2026-10-24）：报告是给排查用的
         （ASCII/id/三条核对），普通用户要决定的只有"会进哪些组、少了哪几条"。
         报告不折叠（它仍是这一页的完整依据），但先让人看见结论。
         **「确认导入」也跟在摘要后面**（2026-10-25）：报告是排查材料，不该把
         唯一的出口压在几十行技术文本之后。 */}}
    {{if .PreviewGroups}}
      <p class="preview-sum"><b>{{.T "import.preview.will"}}</b>
        {{range $i, $g := .PreviewGroups}}{{if $i}}{{$.T "import.preview.sep"}}{{end}}{{$.T "import.preview.group" $g.Title $g.Count}}{{end}}</p>
    {{end}}
    {{with .SkippedItems}}
      <p class="preview-sum"><b>{{$.T "import.preview.wont"}}</b></p>
      {{/* 原因不在这份人话摘要里印：它是写路径的判定原话（带引号与协议名），
           会被 html/template 转成 &#34;，也会把普通人推回技术细节。完整原因
           就在下面报告的「没能进来的」那一节。 */}}
      <ul class="skipped">{{range .}}<li>{{.Name}} <span class="u"> — {{.URL}}</span></li>{{end}}</ul>
    {{end}}
    <p class="hint">{{.T "import.more"}}</p>
    {{/* 令牌是一次性的（过期/用过/不是这个档案都回第一步），所以这一发
         重放也写不进第二次——这比"确认后锁按钮"更可靠，零 JS。 */}}
    <form method="post" action="/import/apply" class="act">
      <input type="hidden" name="token" value="{{.Token}}">
      <button type="submit" class="primary">{{.T "import.apply"}}</button>
      <a class="badge" href="/">{{.T "import.cancel"}}</a>
    </form>
    <div class="rep">{{reportHTML .Report}}</div>
  {{else if eq .Mode "done"}}
    {{/* 走完之后的**结论**，不是预览：写进去了几条、有哪些没能进来。
         逐条点名是这一页存在的全部理由——只印一个"跳过了 N 条"的话，
         那 N 条就再也没人知道了（来源文件里它们看着好好的）。报告全文在这一步
         已经不值得了：它答的是"会导入什么"，而人这时候要的是"成了没有"。 */}}
    <p>{{.T "import.done" .Count}}</p>
    {{with .SkippedItems}}
      <p class="explain">{{$.T "import.done.skipped"}}</p>
      <ul class="skipped">
        {{range .}}<li>{{.Name}} <span class="u"> — {{.URL}}</span>：{{.Reason}}</li>{{end}}
      </ul>
    {{end}}
    {{/* 正文不再摆第二颗「回我的页面」（2026-10-16）：这一页顶栏那颗是无条件
         渲染的（下面 header nav 那一条），两颗逐字相同、都指向 `/`，只是上下
         各一颗——实拍同一屏上两颗一模一样的按钮，读起来像坏了两处。顶栏那颗
         在长名单下面也一直在（这一支的正文可能有几十条跳过项），出口没有丢。 */}}
  {{else if eq .Mode "blocked"}}
    {{/* 这一形状只有一个链接：档案非空 → 导入这条路本来就不通。没有第二句，
         也没有"换个档案试试"——那句话会变成一个新的枚举面。**那一个链接就是
         顶栏那一颗**，所以这一支的正文只剩上面那条提示，是对的（2026-10-16
         把正文里逐字重复的那一颗删掉了）。 */}}
  {{else}}
    <p class="explain">{{.Explain}}</p>
    {{/* multipart 是这一页与其它表单通路唯一的不同：它带文件。
         表单**必须显式写 enctype**——缺了它浏览器会按 urlencoded 发，
         服务端读到的是一个空的文件字段，而页面会说"没有选文件"。 */}}
    <form method="post" action="/import" enctype="multipart/form-data" class="act" novalidate>
      <p><label for="f">{{.T "import.file"}}</label>
        <input id="f" type="file" name="bookmarks" accept=".html,text/html" required></p>
      {{/* **两个按钮，同一个表单**（2026-10-12）：`go=direct` 收下文件就写，
           `go=preview` 给报告等一次点头。

           原来只有后者，于是"导入"这件事在界面上被说成"看这份会导入什么"——
           一个想快点导完的人得先读一屏报告才知道导入根本没坏。

           **被省掉的只是预览，不是那枚一次性令牌**：直接导入照样走
           planImport → applyImport → 快照/历史/rev，判据一份。它跳过的是
           "人读一遍再点头"这一个动作，而不是任何一道闸。

           零 JS：两个 submit 按钮各带 name/value，服务端读 `go` 就分得开。
           用 JS 换按钮会在关掉脚本时把这条路整个关掉。 */}}
      {{/* 「直接导入」是这一屏的主操作（另一颗是"先看一遍"）——它必须 primary，
           否则同一页里报告屏那颗「确认导入」是 primary、而这里没有：主次翻了。 */}}
      <button type="submit" name="go" value="direct" class="primary">{{.T "import.direct"}}</button>
      <button type="submit" name="go" value="preview">{{.T "import.preview"}}</button>
      <a class="badge" href="/">{{.T "import.cancelFirst"}}</a>
    </form>
  {{end}}
</main>
</body>
</html>{{end}}