{{define "import"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Heading}} · launchbay</title>
<style>{{.CSS}}</style>
</head>
<body>
<header>
  <h1>{{.Heading}}</h1>
  <nav aria-label="{{.T "common.back.aria"}}"><a class="badge" href="/">{{.T "common.back.home"}}</a></nav>
</header>
<main role="main">
  {{/* 提示放在最前：读屏的人不该先听完一屏说明才知道刚才那一步没成。
       与选择页/管理页同一条理由。 */}}
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}

  {{if eq .Mode "report"}}
    {{/* 报告**不许折叠**：这一页存在的全部意义就是让人读完再决定。
         `.tech` 是**容器**、换行由 `.tech pre{white-space:pre-wrap}` 给——类要挂
         在外层那个元素上。挂到 <pre> 自己身上时那条规则匹配不上，报告就按默认的
         pre 不换行、横向滚出去，长行右边直接被切掉（浏览器实测才发现）。 */}}
    <p><b>{{.FileName}}</b>{{.T "import.file.sep"}}{{.T "import.intro.a"}}<b>{{.T "import.intro.n" .Count}}</b>{{.T "import.intro.b"}}<b>{{.T "import.intro.m" .Groups}}</b>{{.T "import.intro.c"}}
       {{/* 没能进来的单独说一句：只报"会加几条"会让人以为文件里就这么多书签，
            而少的那些去了哪里只有报告知道。 */}}
       {{if .Skipped}}{{.T "import.skipped.a"}}<b>{{.T "import.skipped.n" .Skipped}}</b>{{.T "import.skipped.b"}} {{end}}{{.T "import.more"}}</p>
    <div class="rep">{{reportHTML .Report}}</div>
    {{/* 令牌是一次性的（过期/用过/不是这个档案都回第一步），所以这一发
         重放也写不进第二次——这比"确认后锁按钮"更可靠，零 JS。 */}}
    <form method="post" action="/import/apply" class="act">
      <input type="hidden" name="token" value="{{.Token}}">
      <button type="submit">{{.T "import.apply"}}</button>
      <a class="badge" href="/">{{.T "import.cancel"}}</a>
    </form>
  {{else if eq .Mode "done"}}
    {{/* 走完之后的**结论**，不是预览：写进去了几条、有哪些没能进来。
         逐条点名是这一页存在的全部理由——只印一个"跳过了 N 条"的话，
         那 N 条就再也没人知道了（来源文件里它们看着好好的）。报告全文在这一步
         已经不值得了：它答的是"会导入什么"，而人这时候要的是"成了没有"。 */}}
    <p>{{.T "import.done.a"}}<b>{{.T "import.done.n" .Applied}}</b>{{.T "import.done.b"}}</p>
    {{with .SkippedItems}}
      <p class="explain">{{$.T "import.done.skipped"}}</p>
      <ul class="skipped">
        {{range .}}<li>{{.Name}} <span class="u"> — {{.URL}}</span>：{{.Reason}}</li>{{end}}
      </ul>
    {{end}}
    <p><a class="badge" href="/">{{.T "common.back.home"}}</a></p>
  {{else if eq .Mode "blocked"}}
    {{/* 这一形状只有一个链接：档案非空 → 导入这条路本来就不通。没有第二句，
         也没有"换个档案试试"——那句话会变成一个新的枚举面。 */}}
    <p><a class="badge" href="/">{{.T "common.back.home"}}</a></p>
  {{else}}
    <p class="explain">{{.Explain}}</p>
    {{/* multipart 是这一页与其它表单通路唯一的不同：它带文件。
         表单**必须显式写 enctype**——缺了它浏览器会按 urlencoded 发，
         服务端读到的是一个空的文件字段，而页面会说"没有选文件"。 */}}
    <form method="post" action="/import" enctype="multipart/form-data" class="act">
      <p><label for="f">{{.T "import.file"}}</label>
        <input id="f" type="file" name="bookmarks" accept=".html,text/html" required></p>
      {{/* **两个按钮，同一个表单**（2026-10-12）：`go=direct` 收下文件就写，
           `go=preview` 给报告等一次点头。

           原来只有后者，于是"导入"这件事在界面上被说成"看这份会导入什么"——
           一个想快点导完的人得先读一屏报告才知道导入根本没坏。

           **被省掉的只是预览，不是那枚一次性令牌**：直接导入照样走
           planImport → applyImport → 快照/历史/rev，判据一份。它跳过的是
           "人读一遍再点头"这一个动作，而不是任何一道闸。

           零 JS：两个 submit 按钮各带 name/value，服务端读 `go` 就分得开。
           用 JS 换按钮会在关掉脚本时把这条路整个关掉。 */}}
      <button type="submit" name="go" value="direct">{{.T "import.direct"}}</button>
      <button type="submit" name="go" value="preview">{{.T "import.preview"}}</button>
      <a class="badge" href="/">{{.T "import.cancelFirst"}}</a>
    </form>
  {{end}}
</main>
</body>
</html>{{end}}