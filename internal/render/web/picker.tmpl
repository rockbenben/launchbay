{{define "picker"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Heading}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<main role="main">
  <h1>{{.Heading}}</h1>
  {{/* 提示放在最前：读屏的人不该先听完一屏档案才知道刚才没进去。
       文案由 httpapi 的白名单给，这里只负责说。 */}}
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}
  {{if .Setup}}
    {{/* 引导建档（设计 §3）：只有名字与口令两格。不问 id（由 store 按名字派生），
         也不给"要不要当管理员"的选项——建出来的这个人就是这台盒子的主人，
         判据在 httpapi 与 store，不在这里。成功之后照样要输 PIN 才进门。 */}}
    <form method="post" action="/setup" class="pick setup">
      <label>名称 <input name="title" type="text" maxlength="60" required autocomplete="off" autofocus></label>
      <label>PIN <input name="pin" type="password" inputmode="numeric" minlength="4" maxlength="6" required autocomplete="off"></label>
      <button type="submit">创建</button>
      {{/* 「这个人」指不到表单里的任何东西（字段叫「名称」）；「建完这一步就不能
           再建第二次」读起来像"这个按钮只能按一次"。说清是什么在关闭：这个页面。
           动词与管理页的「创建档案」统一成「创建」。 */}}
      <p class="hint">第一份建好就是这台导航台的管理员：能进管理页加人、设 PIN、停用与删除。
        这个页面只在一份档案都没有的时候出现；建完这一次它就关掉，以后加人去管理页。</p>
    </form>
  {{else}}
    {{if .Blocked}}
      {{/* 死路①的对策：有档案但一份都进不去时，这一页不许只剩一个空的列表。
           主句按单复数中性写（坏一份时说"这几份"就是说谎），坏的是哪几份写在下面那行——
           分成两段还有个好处：主句一字不差，证人能拿"坏一份 vs 坏三份"逐字比它。
           出路只说一句真话：修那个文件。产品里没有页面内的修法，给个按钮就是假出口。

           措辞（2026-10-10 改判）：这句原来写成"……读不了，进不去。……才进得去"，
           一句话里把"进不去"说了两遍，第二遍还是反过来的说法。改判只去掉这处冗余，
           三个被测试逐字钉住的片段——「数据文件读不了」「要在这台机器上修好那个文件」
           与下面那行「进不去的档案：」——一个都没动。 */}}
      <p class="notice">有档案的数据文件读不了，暂时进不去。要在这台机器上修好那个文件才能继续。</p>
      <p class="hint">进不去的档案：{{range $i, $id := .Blocked}}{{if $i}}、{{end}}<code>{{ $id }}</code>{{end}}</p>
    {{end}}
  <ul class="profiles">
  {{range .Entries}}
    <li>
      {{/* 每张卡片都是一个自包含的表单：profile 走 hidden 字段，
           选档案不需要任何脚本。?add= 同样逐卡片带上，穿过 PIN 步骤。 */}}
      <form method="post" action="/pin" class="pick">
        <input type="hidden" name="profile" value="{{.ID}}">
        {{with $.KeepAdd}}<input type="hidden" name="keep_add" value="{{.}}">{{end}}
        {{with $.KeepAddTitle}}<input type="hidden" name="keep_title" value="{{.}}">{{end}}
        <span class="pick-name"><span class="ic" aria-hidden="true">{{.Letter}}</span><b>{{.Title}}</b></span>
        <label>PIN <input name="pin" type="password" inputmode="numeric" autocomplete="off"
                          minlength="4" maxlength="6" required{{if eq .ID $.Preselect}} autofocus{{end}}></label>
        <button type="submit">进入</button>
      </form>
    </li>
  {{end}}
  </ul>
  {{- if and (not .Entries) (not .Blocked)}}
    {{/* 目录在那儿但没有 profile.json（store 有意不记成坏档：一个手滑 mkdir 的空目录
         不该在家里页面挂红字）。这一支点不出名，只能说那句总的——不编名字。 */}}
    <p class="hint">这台导航台现在没有进得去的档案。</p>
  {{end}}
  {{- end}}
</main>
</body>
</html>{{end}}
