{{define "picker"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Launchbay">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#121417">
<link rel="manifest" href="/manifest.webmanifest">
<title>{{.Heading}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<main role="main" class="chooser">
  {{/* 一张卡都没有时，标题就是那句事实，不是一句问话（判据见 pickerView.NoWayIn）。 */}}
  <h1>{{if .NoWayIn}}{{.T "picker.empty"}}{{else}}{{.Heading}}{{end}}</h1>
  {{/* 提示放在最前：读屏的人不该先听完一屏档案才知道刚才没进去。
       文案由 httpapi 的白名单给，这里只负责说。 */}}
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}
  {{if .Setup}}
    {{/* 第一次打开的人不知道「档案」是书签页（2026-10-24 加）：标题只说"没有进得去的
         档案"，表单只问名字与 PIN，从头到尾没有一句说这一页是干什么的。 */}}
    <p class="hint">{{.T "picker.setup.what"}}</p>
    {{/* 引导建档（设计 §3）：只有名字与口令两格。不问 id（由 store 按名字派生）。
         语言**不在这张表单里**——它在下面自己的表单上（2026-10-12）：绑在一张
         别的表单里，它的生效时机就成了"按另一个按钮"，人拨完下拉页面纹丝不动，
         连下拉自己的标签都还是原来那种语言，看上去就是坏的。而这是新装机的
         人看到的第一块屏幕。成功之后照样要输 PIN 才进门。 */}}
    <form method="post" action="/setup" class="pick setup" novalidate>
      <label>{{.T "picker.setup.name"}} <input name="title" type="text" maxlength="{{profileTitleMax}}" required autocomplete="off" autofocus value="{{.FormTitle}}"></label>
      {{/* PIN 改成**选填**（2026-10-12），不设防是同一个动作的另一端。
           为什么不是"留空就行"：忘了敲一位就回车，会静悄悄地建出一份局域网里
           谁都能进的书签页，而这个产品最核心的那句承诺正是"各人一份，别人看不见"。
           多了这一格勾选，换来的是"不设防"永远是一个**被说出来**的决定。
           `required` 因此摘掉，minlength/maxlength 留着（对空值不生效，只管手滑打短的）。
           判据只有 httpapi 的 `wantsNoPin` 一处。 */}}
      {{/* 格式写在标签上，不等人说错了才告诉他（2026-10-16）。管理页那一格
           （admin.pin.field）一直带着"4 到 6 位数字"，而**第一次给人定 PIN 的
           是这一屏**——原先这里只有一个「PIN」，规则只在撞了 `?err=badpin` 之后
           才出现。一张谁都没见过的表单，不该靠失败来教格式。 */}}
      <label>{{.T "picker.setup.pinField"}} <input name="pin" type="password" inputmode="numeric" autocomplete="off"
                            minlength="{{pinMin}}" maxlength="{{pinMax}}"></label>
      <label class="chk"><input type="checkbox" name="nopass" value="1"> {{.T "picker.setup.nopass"}}</label>
      <p class="hint">{{.T "picker.setup.nopassHint"}}</p>
      <button type="submit" class="primary">{{.T "picker.setup.submit"}}</button>
      {{/* 「这个人」指不到表单里的任何东西（字段叫「名称」）；「建完这一步就不能
           再建第二次」读起来像"这个按钮只能按一次"。说清是什么在关闭：这个页面。
           动词与管理页的「创建档案」统一成「创建」。 */}}
      <p class="hint">{{.T "picker.setup.hint"}}</p>
    </form>
    {{/* 界面语言：**自己的表单、自己的按钮**。零 JS——按下去就是一次普通 POST，
         页面用新语言重画，所以"生效"是看得见的。按钮上的字按**当前**语言写：
         第一次看见它写「切换语言」，切完之后同一颗按钮改写「Switch language」。 */}}
    <form method="post" action="/lang" class="langsel">
      <label>{{.T "lang.pick"}}
        <select name="language">
          {{range .Langs}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </label>
      <button type="submit">{{.T "lang.applyNow"}}</button>
      <p class="hint">{{.T "lang.hintLater"}}</p>
    </form>
  {{else}}
    {{/* 进管理页的那颗口子**一直画着**（2026-10-15 改判）。原先判据是 `HasAdmin`
         （带着 lb_admin 才画），理由是"没管理权的人看见它只会落到登录页"——可那句
         恰好说反了：刚装完机器的人手里只有 compose 里那把 key，还没有任何 cookie，
         于是这一条**永远不画**，全站再没有第二处通向 /admin，他只能自己把地址打出来。
         一台装好的机器上，账号层面那一整页（加人、设 PIN、停用、删档）在界面上不可达。
         判据换成"这一页本来就在说这台机器"：这一页问的是哪一份，而管理讲的是这台
         机器，同一层的话该在同一屏。落到登录页不是代价而是目的——GET /admin 没有
         管理权时答的本来就是那张登录页（2026-10-12 那条改判），而 key 不对只多说一句
         「这把管理密钥不对」。档案页顶栏那枚「管理」徽标仍按 HasAdmin 画：那是给已经
         登进来的人的捷径，不是门。 */}}
    {{/* 「管理这台机器」与卡里的「进入」**同一套词汇、不同重量**（2026-10-17）：
         `a.badge` 就是中性描边那张脸（base.css：动作那一半与 `.pick button` 同一张），
         「进入」是填充的主键。两个动作曾经是一个满宽、一个缩成小角标，主次倒挂。

         而 `<p class="plain">` 那个 class 是**卡片族**（.card/.plain 同一条规则：描边、
         圆角、底色、flex），套在段落上会让这一行变成一个空盒子——实拍 390 宽下，
         「管理这台机器」上方多出一整块空白的圆角面板，比它本来的角标还抢眼。
         段落只留自己的 class。 */}}
    {{if .Blocked}}
      {{/* 死路①的对策：有档案但一份都进不去时，这一页不许只剩一个空的列表。
           主句按单复数中性写（坏一份时说"这几份"就是说谎），坏的是哪几份写在下面那行——
           分成两段还有个好处：主句一字不差，证人能拿"坏一份 vs 坏三份"逐字比它。
           出路只说一句真话：修那个文件。产品里没有页面内的修法，给个按钮就是假出口。

           措辞（2026-10-10 改判）：这句原来写成"……读不了，进不去。……才进得去"，
           一句话里把"进不去"说了两遍，第二遍还是反过来的说法。改判只去掉这处冗余，
           三个被测试逐字钉住的片段——「数据文件读不了」「要在这台机器上修好那个文件」
           与下面那行「进不去的档案：」——一个都没动。 */}}
      <p class="notice">{{.T "picker.blocked.main"}}</p>
      <p class="hint">{{.T "picker.blocked.which"}}{{range $i, $id := .Blocked}}{{if $i}}{{$.T "picker.blocked.sep"}}{{end}}<code>{{ $id }}</code>{{end}}</p>
    {{end}}
  <ul class="profiles">
  {{range .Entries}}
    <li>
      {{/* 每张卡片都是一个自包含的表单：profile 走 hidden 字段，
           选档案不需要任何脚本。?add= 同样逐卡片带上，穿过 PIN 步骤。 */}}
      <form method="post" action="/pin" class="pick" novalidate>
        <input type="hidden" name="profile" value="{{.ID}}">
        {{with $.KeepAdd}}<input type="hidden" name="keep_add" value="{{.}}">{{end}}
        {{with $.KeepAddTitle}}<input type="hidden" name="keep_title" value="{{.}}">{{end}}
        {{/* 卡上是**名字 + 一枚文字头像**（2026-10-12 起是服务图标，2026-10-17 改回
             文字）。两样各司其职，谁也不顶谁：

             **名字是区分档案的那一维**——共用一台电脑的一家人靠"哪张卡是我的"认人。

             **脸是档案名的首字母色块**（判据在 icon.go 的 faceOf，2026-10-17 用户
             决定）：从前这里是"这个人最常用站点的图标"，而它会认错人（叫「爸爸」的
             档案配 YouTube 图标像别人的账号照片）、两份档案可能撞成同一张脸、
             并且当着全家人的面说出了收藏内容。理由全文记在 faceOf 上。

             按钮的 aria-label 保留：读屏停在「进入」上时，念出来的是"进入爸爸的
             书签页"而不是光一个"进入"。 */}}
        <span class="pick-head">
          <span class="pick-face">{{template "icon" .Icon}}</span>
          <b class="pick-name">{{.Title}}</b>
        </span>
        {{/* **不设防的那一份不给 PIN 输入框，也不多说一句**（2026-10-12）。
             没有那个框，卡上就是空的，按「进入」直接进——这就是全部语义。

             这里原先印过一句「不设 PIN，点一下就进」，2026-10-12 撤掉：卡上已经有
             名字与图标，再加一行说明就成了一段说明书，而那一行的代价是**每张
             不设防的卡都比旁边高一截**，一排卡片底边参差。真要交代代价，位置在
             建档那一步（勾选框下面那句）与这一页的管理员那里——**建档时说一句，
             进门时不必再说第二遍**。 */}}
        {{if .NeedsPIN}}
          {{/* 卡上那一格也要说清格式（2026-10-20）。**建档那屏**早就有「4 到 6 位数字」
               （picker.setup.pinField），而**第一次给这一份定 PIN 的其实正是这一屏**——
               从前这里只有一个「PIN」，规则只在撞了 `?err=badpin` 之后才出现。
               卡只有 150–190px 宽（.profiles 那一档），格式塞不进标签里，于是放在
               输入框的 placeholder 上：它是**一直看得见**的那一格（输入框里一敲就没了，
               但那时人已经知道格式了）。minlength/maxlength 仍由浏览器兜着。 */}}
          <label>{{$.T "picker.setup.pin"}} <input name="pin" type="password" inputmode="numeric" autocomplete="off"
                            minlength="{{pinMin}}" maxlength="{{pinMax}}" required{{if eq .ID $.Preselect}} autofocus{{end}}
                            placeholder="{{$.T "picker.pin.hint"}}"></label>
        {{end}}
        {{/* 两个动作**同一套词汇**（2026-10-17）：「进入」是 card 主键（fld primary，
             满宽是卡片该有的样子），「管理这台机器」从前是一枚 badge 角标——于是
             一屏上最重要的动作铺满整卡、去管理这台机器的那颗却缩成一个标签，主次
             完全倒挂。两颗现在都是 `.fld`，差别只在填充色。 */}}
        <button type="submit" class="fld primary" aria-label="{{$.T "picker.enterNamed" .Title}}">{{$.T "picker.enter"}}</button>
      </form>
    </li>
  {{end}}
  </ul>
  {{- /* 「新建自己的一份」（2026-10-23）：**非管理员自己建一份档案**的入口。
         它折叠着，因为这一页的正事是「选你是谁」，建档是另一件事——而它一旦
         展开，页面就成了一个表单页。

         表单与引导那一张同一副脸（同一套字段、同一套判据、同一句代价说明），
         只是落在 /new 上：/setup 是「零档案时的第一个」（建完那条路自己关），
         这一条是「随时可建」。**零档案那一支画的是引导表单**，所以有档案时
         这里才出现——那一支的建档入口是那一张表单，不是这一张。

         为什么它不要求管理权（这是这一族最容易被当成漏洞的地方，所以理由写在
         handler 那边的注释里）：§11 明写不防局域网内冒充，而建出来的那一份是
         **空的**、只属于它自己的 PIN，它不授予任何读取别人书签的权限。反过来，
         「要管理员才能建」意味着这台机器上第一个想用的人得等家长回来开一次
         管理页——那正是这个产品要拿掉的形状。代价明写：局域网里任何设备都能
         建档，于是这一页上会多出一张卡（管理员随时能删掉它）。 */}}
  <details class="pick-new"{{if .NewOpen}} open{{end}}>
    <summary>{{.T "picker.new.summary"}}</summary>
    <form method="post" action="/new" class="pick setup" novalidate>
      <label>{{.T "picker.setup.name"}} <input name="title" type="text" maxlength="{{profileTitleMax}}" required autocomplete="off" value="{{.FormTitle}}"></label>
      {{/* 格式写在标签上，与引导那张同一句话（picker.setup.pinField）；PIN 选填，
           「不设 PIN」是单独勾出来的一个决定（判据在 httpapi 的 wantsNoPin）。 */}}
      <label>{{.T "picker.setup.pinField"}} <input name="pin" type="password" inputmode="numeric" autocomplete="off"
                            minlength="{{pinMin}}" maxlength="{{pinMax}}"></label>
      <label class="chk"><input type="checkbox" name="nopass" value="1"> {{.T "picker.setup.nopass"}}</label>
      <p class="hint">{{.T "picker.setup.nopassHint"}}</p>
      <button type="submit" class="primary">{{.T "picker.new.submit"}}</button>
      <p class="hint">{{.T "picker.new.hint"}}</p>
    </form>
  </details>
  {{- /* 「管理这台机器」挪到**卡片之后**（2026-10-20）：它原本排在 h1 底下、
       卡片之前——一台机器级的动作压在「这一份是谁」上面，读起来像这一页的正事。
       现在它在下面一行、居中，与登录页那个回链同一张脸（.pick-admin 与
       .login-back 同一档），而**它必须一直画着**（刚装完机器的人手里只有
       compose 里那把 key，界面上没有第二处通向 /admin 的路）。

       注释用 `{{-` 收掉前面的空白：注释本身不渲染，可它两边的换行与缩进
       会漏进输出——那一页的接缝是被逐字钉着的（views_test 的「三形状」）。 */}}
  <p class="pick-admin"><a class="badge" href="/admin">{{.T "picker.adminLink"}}</a></p>
  {{- end}}
  {{/* 源码与需求在 GitHub 上（2026-10-20 加，同日撤了）：这一枚曾先后落在
       **顶栏**、**设置面板最下面**与**这里**（进门页），三处都被否了——
       顶栏那一排是「这台机器/这一份」的动作，源码链接放那儿是抢主视觉区；
       面板最下面紧挨着「回我的页面」，挨着的读起来像个导航项；这一页是
       「选你是谁」的过场页，一枚孤零零的猫浮在卡片中间像「页面没画完」。
       它现在住在**档案页的页脚**（正文最下面那一行）——网页上「源码/仓库」
       历来所在的位置，也是那一页最不抢眼的一处。 */}}
</main>
</body>
</html>{{end}}
{{/* 图标三级兜底在 profile.tmpl 里有一份同名的 define（那里是给条目用的）。
     这一份是**同一段判据的第二处落点**，不是第二套规则：谁画出那张脸由
     icon.go 的 pieceFor/faceOf 判完，模板只按 SVG > Img > Letter 端出去。

     它没有做成"两个模板共用一个 define"是因为它们各自 Parse（newExecutor）成
     两个互不相干的模板集；为了共用五六行而把四个页面的模板并成一个集，是一次
     远大于这五六行的改动。**要改这段三取一，就两处一起改**——判据仍只有一份，
     落在 Go 侧那一份。 */}}
{{define "icon"}}
{{- if .SVG}}
{{.SVG}}
{{- else if .Img}}
<img class="ic-img" src="{{.Img}}" alt="" aria-hidden="true" width="40" height="40">
{{- else}}
<span class="ic" style="--chip-h:{{.ChipHue}}" aria-hidden="true">{{.Letter}}</span>
{{- end}}
{{- end}}
