{{define "admin"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.T "admin.title"}}</title>
<style>{{.CSS}}</style>
</head>
<body>
<header class="adm-bar">
  <h1>{{.T "admin.title"}}</h1>
  {{/* 「退出管理」住在顶栏，与「回首页」同一族：两者都是**这台机器的会话动作**，
       不是管理页的内容。原先它挂在建档表单底下，看上去像一张表单漏出来的第二颗
       按钮——没有标题、没有上下文，读起来像误渲染（2026-10-12 改）。
       表单形态留着（零 JS：它是一次 POST），尺寸收成徽标那颗。 */}}
  <nav aria-label="{{.T "admin.nav.aria"}}">
    <form method="post" action="/admin/logout" class="profmenu">
      <button type="submit" class="badge">{{.T "admin.logout"}}</button>
    </form>
    <a class="badge" href="/">{{.T "common.back.home"}}</a>
  </nav>
</header>
{{/* 2026-10-16 重排。此前这一页是**四样东西竖着排下来**：档案表、一张没有标题的
     建档表单、语言表单、书签栏说明——四块之间只靠空白分隔，其中只有两块有 h2，
     而没有标题的那张表单（建档）紧贴在档案表下面，读起来像表格的续行。
     1440 实拍还量到另一件事：四块全都铺到 1368px，而建档那行控件只占约 700px、
     语言那块约 330px——右边三分之二是空的。

     改成**三节**，每节一个 h2（h2::before 那枚色点自动跟上，全案一致）：
       ① 这台机器上的档案 —— 表格
       ② 加一个人         —— 建档表单（补上标题与它自己的说明）
       ③ 这台机器的设置   —— 语言、管理密钥与书签栏并排
     主栏同时收窄（.adm-page）：这一页是**一个人偶尔来一次**的设置页，
     不是档案页那种铺满的卡片墙；1600 那条上限是给档案页量的。 */}}
<main role="main" class="adm-page">
  {{/* 提示放在表之前：与进门页同一条理由——读屏的人不该先听完一整表
       才知道刚才那条没建上。文案由 httpapi 的白名单给，这里只印。 */}}
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}
  {{/* 这一行**不是**搜索命中读数（`.hits` 在档案页是那个意思）：它是这一页的
       档案总数。同一个类名在两页说两件事，而这一句也不是标题——它归在这一节
       的 h2 底下，所以给它自己的一类（2026-10-20）。 */}}
  <p class="adm-count">{{.T "admin.count" .Count}}</p>

  <section class="adm-sec">
    <h2>{{.T "admin.sec.profiles"}}</h2>
    {{/* 一行一个档案 + 条目数 + rev + 最近改动时间（spec §8.8）。这一页的存在
         本身就是敏感信息，所以它 no-store、**没有管理权时另渲染登录页**（200，不是
         303——2026-10-12 起管理员不再挂在任何档案上，见 adminlogin.tmpl），且
         **一个条目内容都不带**：只有数量。id 与 title 并列在名字格里——id 是 API
         寻址用的 handle，坏档案那行 profile.json 读不出 title 时也要留得下定位信息。*/}}
    {{/* 每一格都带 data-k：窄屏（≤700）这张表换成一格一行、行首挂列名的读法，
         列名与表头同一份文字，由 CSS 的 ::before 取 attr(data-k) 印出来。 */}}
    <table class="adm">
      <thead>
        <tr><th>{{.T "admin.col.profile"}}</th><th>{{.T "admin.col.items"}}</th><th>{{.T "admin.col.rev"}}</th><th>{{.T "admin.col.modified"}}</th><th>{{.T "admin.col.snapshots"}}</th><th>{{.T "admin.col.actions"}}</th></tr>
      </thead>
      <tbody>
      {{range .Rows}}
        <tr>
          <td data-k="{{$.T "admin.col.profile"}}"><span class="name"><b>{{if .Title}}{{.Title}}{{else}}{{.ID}}{{end}}</b>{{/* id 是**从名字派生**的（store 的 DeriveID），所以 ASCII 名字那一
             份（rockben、NAS、dad…）标题与 id 是同一个词——两个都印就成了
             「rockben rockben」。同一份只印一次：id 那一格是给 API 寻址用的
             handle，而动作键的链接里已经带着它。标题读不出来（坏档）时，
             那一格仍然只剩 id，定位信息不丢。 */}}{{if and .Title (ne .ID .Title)}} <code>{{.ID}}</code>{{end}}
            {{/* 「管理员」那一枚徽标 2026-10-12 删掉了：档案不再有管理员属性，
             「谁能管这台机器」是**这一页的访问权**，不是那一行档案的属性。 */}}
            {{/* 停用、坏档与「没 PIN」是三种不同的状态，同色会让管理员分不清该做什么：
                 停用是有人把它关上了（启回来就好）；
                 坏档是数据读不出来（得修文件）；
                 没 PIN 是这一份在局域网里**谁都能进**（该给它加一道锁）。
                 前两枚安静，第三枚用告警色——它是唯一一件"现在就该动手"的。 */}}
            {{if .Disabled}}<span class="badge">{{$.T "admin.badge.disabled"}}</span>{{end}}
            {{if .Broken}}<span class="badge warn">{{$.T "admin.badge.broken"}}</span>{{end}}
            {{if and (not .Broken) (not .PinSet)}}<span class="badge warn">{{$.T "admin.badge.nopin"}}</span>{{end}}</span></td>
          <td data-k="{{$.T "admin.col.items"}}" class="col-metric">{{if .Broken}}—{{else}}{{.Items}}{{end}}</td>
          <td data-k="{{$.T "admin.col.rev"}}" class="col-metric">{{if .Broken}}—{{else}}{{.Rev}}{{end}}</td>
          {{/* 这一格从前直接印 statusRows 给的 RFC3339 UTC 原文
               （`2026-10-10T09:33:08Z`）：家里人说"什么时候改的"要自己解析 T 与 Z。
               格式化放在渲染侧（shortTime），判据仍只有一份——数据那头不动。 */}}
          <td data-k="{{$.T "admin.col.modified"}}" class="col-time">{{if .Modified}}{{shortTime $.Lang .Modified}}{{else}}—{{end}}</td>
          <td data-k="{{$.T "admin.col.snapshots"}}" class="col-metric">{{.Snapshots}}</td>
          <td data-k="{{$.T "admin.col.actions"}}">
            {{if .Broken}}
              {{/* 点了没反应的东西不进界面：坏档改不了（④.6 的 rebuild 那条路才要改），
                   所以坏档这一格是文字，不是按钮。这一句从前写"先进那个档案修数据文件"
                   ——profile.json 读不动的人根本进不去，那是一句做不到的承诺
                   （§12：坏数据不许换来假出口）。 */}}
              <span class="adm-note">{{$.T "admin.act.repair"}}</span>
            {{else}}
              {{/* **「进入编辑」整枚删掉了**（2026-10-10 改判）：它就是
                   `POST /switch to=<id>` 的一枚按钮，而那条路是管理员免 PIN 直达
                   别人的台去改书签的唯一入口——正是本设计要拿掉的形状。
                   这一格现在只剩**账号层面**的动作：加/改 PIN、停用、删档。
                   管理员管账号，不管内容。

                   设 PIN 与删档是**链接**不是按钮：它们各自先 GET 一张写明后果的
                   确认页，那是两步二次确认的第一步。零 JavaScript——不用 confirm()，
                   那个对话框样式不可控、移动端上常常直接不出现，而它是唯一挡在
                   "手滑删掉一个人"前面的东西（§8.8，2026-10-09 改判）。

                   CanSetPin / CanDelete 由 httpapi 算好传下来（§8.8 的两条形状闸），
                   **模板不判断**。给了而点了必被拒的入口就是死按钮，比没有更费人。

                   2026-10-20：加/改 PIN 这一枚**对每一份档案都在**（含自己正在用
                   的那一份）——管理员是机器级的一把 key，"改自己的 PIN 要旧 PIN"
                   在这里让开（本人自己那边照样要旧 PIN，见 self/pin）。
                   删档与停用**仍然不给**自己正在用的那一份：那是会话层面的事。 */}}
              <span class="acts">
              {{if .CanSetPin}}
                {{/* 说的是"加"还是"改"：判据是这一份现在有没有 PIN（auth.HasPin），
                     值由 httpapi 算好传下来。同一枚键在两种情形下说两件事，
                     人不用点进去才知道这一份是锁着的还是开着的。 */}}
                <a class="badge" href="/admin/pin?profile={{.ID}}">{{if .PinSet}}{{$.T "admin.act.changepin"}}{{else}}{{$.T "admin.act.addpin"}}{{end}}</a>
              {{end}}
              {{if .CanToggleDisabled}}
                <a class="badge" href="/admin/disable?profile={{.ID}}">{{if .Disabled}}{{$.T "admin.act.enable"}}{{else}}{{$.T "admin.act.disable"}}{{end}}</a>
              {{end}}
              {{if .CanDelete}}
                <a class="badge danger" href="/admin/delete?profile={{.ID}}">{{$.T "admin.act.delete"}}</a>
              {{end}}
              </span>
              {{/* 这一格下面那句话说的是"**为什么少了两颗键**"。它原先用的是
                   `.plain`——那是书签卡那一族的脸（带边框与底色），于是在表格里
                   撑成一个大白框，看着像一颗按不动的按钮（1440 实拍）。
                   现在它是一条安静的说明（.adm-note），与动作键分属两行。 */}}
              {{if .IsActive}}<span class="adm-note">{{$.T "admin.act.active"}}</span>{{end}}
            {{end}}
          </td>
        </tr>
      {{else}}
        <tr><td colspan="6" class="col-empty">{{$.T "admin.profiles.empty"}}</td></tr>
      {{end}}
      </tbody>
    </table>
  </section>

  <section class="adm-sec">
    <h2>{{.T "admin.sec.add"}}</h2>
    {{/* 这一节的标题是**新加的**（2026-10-16）。此前这张表单没有标题也没有说明，
         紧贴在档案表下面——上一屏刚看完一行「Dad / 5 / 7」，下一行就开始问
         "这个人的名字"，两件事之间没有任何一句话说它们不是同一件事。 */}}
    <p class="hint">{{.T "admin.new.hint"}}</p>
    {{/* 建档表单：两格。id 不问（由名字派生，判据在 store），PIN 存哈希。
         **没有第三个勾选**（2026-10-12）：档案不再是管理员，所以"建成管理员"
         这个动作已经不存在了。留着那个勾选框会让人以为勾了就能管这台机器，
         而它现在连字段都不收。

         2026-10-20：两格从"标签在左、输入框在右"改成**标签在上**（.fld）。
         原来那一行是「这个人的名字 [框] | PIN（4 到 6 位数字）[框] | [勾] 创建」，
         两个标签把输入框挤到右边各剩几百像素，而"PIN（4 到 6 位数字）"这个标签
         本身就有 130px——读起来像在一堆字里找输入框。竖排之后每一格自带
         "名字 + 框"、"PIN + 框"，两格并排、下面一行是勾选与按钮。 */}}
    <form method="post" action="/admin" class="adm newprofile">
      <div class="newprofile-fields">
        <label class="fld">{{.T "admin.new.title"}} <input name="title" type="text" maxlength="60" required autocomplete="off"></label>
        {{/* 格式写在标签上，不等人说错了才告诉他——与引导建档那一屏同一处置
             （picker.setup.pinField，2026-10-16 那一轮定的规矩）。这一格原先只有
             「PIN」两个字，规则要等撞了 `?err=badpin` 才出现。 */}}
        <label class="fld">{{.T "picker.setup.pinField"}} <input name="pin" type="password" inputmode="numeric" autocomplete="off"
          minlength="{{pinMin}}" maxlength="{{pinMax}}"></label>
      </div>
      <div class="newprofile-foot">
        {{/* 与引导页同一件事：PIN 选填，勾了「不设 PIN」才真的不设。判据是
             httpapi 的 wantsNoPin，模板只负责把那个意图发出去。
             下面那句代价说明**复用引导页那一条**（admin 这一格本来就复用
             picker.setup.nopass 那个标签），同一句话说两处就要两处一起改。 */}}
        <label class="chk"><input type="checkbox" name="nopass" value="1"> {{.T "picker.setup.nopass"}}</label>
        <button type="submit" class="primary">{{.T "admin.new.submit"}}</button>
      </div>
    </form>
    <p class="hint">{{.T "picker.setup.nopassHint"}}</p>
  </section>

  <section class="adm-sec">
    <h2>{{.T "admin.sec.machine"}}</h2>
    {{/* 语言、管理密钥与书签栏并排（2026-10-16 改成两栏；2026-10-20 左栏多一块
         「管理密钥」）：这三样都是**这台机器**的设置，与上面两节（这台机器上
         有谁 / 再加一个）不是一层。宽屏上并排，≤900 折回一列——左栏那两块内容
         都短、书签栏那段长，同栏上下排会留一大段空。 */}}
    <div class="adm-two">
      <div class="adm-col">
        {{/* 界面语言：**站级**设置，不是某个档案的。所有页面都用它，所以它不进
             profile.json、不走 /prefs——那两条都是"只改我自己"的通路，而语言改了
             会立刻影响这台机器上的所有人。落点是 data/settings.json，判据与选项由
             渲染器给（它同时知道"现在是什么语言"与"有哪些可选"）。

             只给管理员：**只有管理员能改全机显示**。它不进 /admin/pin 那两步确认——
             那套是给"改坏了撤不回来"的动作准备的，改语言随时改回来，且一个字节的
             档案数据都不动。 */}}
        {{/* 界面语言：**站级的默认语言**（2026-10-20 改判）——每一份档案可以
             自己记一份语言，没记的用这里这一个；每个人也可以在自己的台面面板
             里改自己的那一份。判据是 i18n.ProfileLang。
             这一块改的是 data/settings.json，删档不动它。 */}}
        <form method="post" action="/admin/language" class="adm langform">
          <h3>{{.T "admin.lang.h2"}}</h3>
          <p class="hint">{{.T "admin.lang.hint"}}</p>
          <label>{{.T "lang.pick"}}
            <select name="language">
              {{range .Langs}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>{{end}}
            </select>
          </label>
          <button type="submit">{{.T "lang.submit"}}</button>
        </form>
        {{/* 管理密钥（2026-10-20）。这一块回答一个装机器的人最先问的问题：
             "我该输什么？"——**默认那把是 compose 里写着的那个公开值**。

             **当前配置的那一把一个字都不进页面**：它会进 devtools、进导出、进
             浏览器同步。进页面的只有"默认那把"（公开知识）与"这台机器是不是还
             在用它"（只有进了管理页的人才看得到）。 */}}
        <section class="adm keycard">
          <h3>{{.T "admin.key.h2"}}</h3>
          {{if .Key.UsingDefaultAdminKey}}<span class="badge warn">{{.T "admin.key.warn"}}</span>{{end}}
          <p>{{.T "admin.key.p1"}}</p>
          <p>{{.T "admin.key.p2a"}}<code>{{.Key.DefaultAdminKey}}</code>{{.T "admin.key.p2b"}}</p>
        </section>
      </div>
      {{/* bookmarklet 的入口与**怎么用**。
           它放在管理页而不是顶栏：这是一次性配置，配好全家用；而顶栏那几样是
           每个人每天都要按的（§8.1）。零 JS——一个链接加几句说明，不需要脚本。

           **只给链接是不合格的出口**：/bookmarklet 会吐出一行 javascript: 源码，
           而"怎么把这一行变成书签栏里那个能点的按钮"没人天生知道。所以步骤写在这里，
           而不是让人自己摸索。 */}}
      <section class="adm bm">
        <h3>{{.T "admin.bm.h2"}}</h3>
        {{/* 术语统一：这一页别处都叫「PIN」，这段从前一半写「口令」一半写「PIN」，
             同一段里两个词指同一个东西。「会话写」是工程话，换成"按你当前登录的档案存"。 */}}
        <p>{{.T "admin.bm.p1"}}<em>{{.T "admin.bm.p1em"}}</em>{{.T "admin.bm.p2"}}<strong>{{.T "admin.bm.p2b"}}</strong>{{.T "admin.bm.p3"}}</p>
        <ol>
          <li>{{.T "admin.bm.li1a"}} <a href="/bookmarklet" class="badge">{{.T "admin.bm.src"}}</a>{{.T "admin.bm.li1b"}} <code>javascript:</code>{{.T "admin.bm.li1c"}}</li>
          <li>{{.T "admin.bm.li2"}}</li>
          <li>{{.T "admin.bm.li3a"}}<strong>{{.T "admin.bm.li3b"}}</strong>{{.T "admin.bm.li3c"}}</li>
        </ol>
        <p class="plain">{{.T "admin.bm.plain1"}}<strong>{{.T "admin.bm.plain1b"}}</strong>{{.T "admin.bm.plain2"}}<strong>{{.T "admin.bm.plain2b"}}</strong>{{.T "admin.bm.plain3"}}</p>
      </section>
    </div>
  </section>
</main>
</body>
</html>{{end}}
