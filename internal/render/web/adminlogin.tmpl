{{define "adminLogin"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.T "admin.login.title"}}</title>
<style>{{.CSS}}</style>
</head>
<body>
{{/* 管理员的进门页（2026-10-12）。管理员不再是某个档案，于是这一页不再挂在
     任何人的 lb_profile 上——它是**这台机器一把 key** 的输入框。
     零脚本：form 提交，POST /admin/login 判完发一条 lb_admin 再 303。 */}}
{{/* 2026-10-16 重排。此前是四块各自成块、靠左对齐排下来，1440 实拍量到三种宽度：
     h1 占满 chooser 的 728、卡 460、回链那个 .plain 又 630——右边缘三个位置，
     读起来像一个没排完的 L 形。改成**一个卡**：标题进卡（与卡同宽），一句话说清
     这把钥匙开的是哪一面，脚注说它从哪来、回链退成一枚 chip 且不再自带框。

     为什么不是给每块各收一档：那是把错位抹平，形状仍然是"一个标题带三块东西"。
     这一页只有一个动作，把它装进一张卡里，页面就只有**一件**要做的事。

     2026-10-20：卡里多一段"默认那把是 launchbay123"。装机器的人第一次站在
     这一页上，要的就是这句话——**当前配置的那一把一个字都不进页面**，进页面的
     只有 compose 里那个**公开的**默认值（认得它的人本来就管得了这台机器）。 */}}
<main role="main" class="chooser">
  <form method="post" action="/admin/login" class="pick login" novalidate>
    <h1>{{.T "admin.login.title"}}</h1>
    {{/* 提示留在最前：读屏的人不该先听完这一页才知道刚才那把 key 不对。 */}}
    {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}
    {{/* 一句话说清这把钥匙**开什么**（账号那一面），下一段说它从哪来与它看不见什么。
         两句各说一件，不互相重复——重说一遍的代价是读的人要自己判断两段是不是
         同一件事，而页面上没有一句话是多余的。 */}}
    <p class="login-lede">{{.T "admin.login.lede"}}</p>
    <label>{{.T "admin.login.key"}} <input name="key" type="password" required autocomplete="off" autofocus></label>
    <button type="submit" class="primary">{{.T "admin.login.submit"}}</button>
    {{/* 这一段是这一页存在的理由：key 在 docker-compose.yml 里，不在任何档案上，
         而"输 PIN 进自己的台"与"管这台机器"是两件不同的事。不说清的话，人会去
         档案页找那个设置，而那里没有。它是卡里的脚注——按钮与它之间那条细线就是
         "上面那些是这一屏，下面这句是另一回事"的分界。 */}}
    <div class="login-where">
      <p class="login-default">{{.T "admin.login.default"}}<code>{{.Key.DefaultAdminKey}}</code></p>
      <p>{{.T "admin.login.defaultNote"}}</p>
      <p>{{.T "admin.login.scope"}}</p>
    </div>
  </form>
  {{/* 「回选择页」不再装进 .plain 那个框：`.plain` 是**书签卡那一族**里的一个类，
       它意味着"一张和别的卡片同款的卡，只是不能点"。一个回链拿这张脸，
       等于把三级出口画成一张内容卡——而它此前量到的 630px 宽也比卡本身还宽。 */}}
  <p class="login-back"><a class="badge" href="/">{{.T "common.back.picker"}}</a></p>
</main>
</body>
</html>{{end}}
