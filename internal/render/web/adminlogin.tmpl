{{define "adminLogin"}}<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.T "admin.login.title"}}</title>
<style>{{.CSS}}</style>
</head>
<body>
{{/* 管理员的进门页（2026-10-12）。管理员不再是某个档案，于是这一页不再挂在
     任何人的 lb_profile 上——它是**这台机器一把 key** 的输入框。
     零脚本：form 提交，POST /admin/login 判完发一条 lb_admin 再 303。 */}}
<main role="main" class="chooser">
  <h1>{{.T "admin.login.title"}}</h1>
  {{with .Notice}}<p class="notice" role="alert">{{.}}</p>{{end}}
  <form method="post" action="/admin/login" class="pick login">
    <label>{{.T "admin.login.key"}} <input name="key" type="password" required autocomplete="off" autofocus></label>
    <button type="submit" class="primary">{{.T "admin.login.submit"}}</button>
  </form>
  {{/* 这一段是这一页存在的理由：key 在 docker-compose.yml 里，不在任何档案上，
       而"输 PIN 进自己的台"与"管这台机器"是两件不同的事。不说清的话，人会去
       档案页找那个设置，而那里没有。 */}}
  <p class="hint">{{.T "admin.login.hint"}}</p>
  <p class="plain"><a class="badge" href="/">{{.T "admin.login.back"}}</a></p>
</main>
</body>
</html>{{end}}