{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.5",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "notifications"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
